# MongoDB connection string used by the backend
MONGO_URI=mongodb://127.0.0.1:27017/ai_resume_analyzer

# Use a random value with at least 32 characters in local/production environments
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Google GenAI key used for interview report generation
GOOGLE_GENAI_API_KEY=replace-with-your-google-genai-api-key

# Optional settings
JWT_ISSUER=ai-resume-analyzer
JWT_AUDIENCE=ai-resume-analyzer-web
JWT_EXPIRES_IN=2h
COOKIE_SAMESITE=lax
